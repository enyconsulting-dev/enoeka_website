# GoHighLevel inbound webhook URL for all forms (server-side only — not NEXT_PUBLIC)
GHL_WEBHOOK_URL=

# Cloudflare Turnstile (site key is public; keep the secret server-side)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: public Calendly URLs for embeds
NEXT_PUBLIC_CALENDLY_DISCOVERY=
NEXT_PUBLIC_CALENDLY_SPEAKER=
